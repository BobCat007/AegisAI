# Copy to .env and add your Google AI Studio API key. Never commit .env.
GEMINI_API_KEY=
AEGISAI_GEMINI_MODEL=gemini-3.8-flash
AEGISAI_GEMINI_TIMEOUT_SECONDS=45

# Telemetry persistence and retention
AEGISAI_TELEMETRY_PATH=data/telemetry/events.jsonl
AEGISAI_TELEMETRY_MAX_EVENTS=100000

# Require X-AegisAI-API-Key on API routes
AEGISAI_API_AUTH_ENABLED=true
AEGISAI_API_KEY=

# Optional active authorization assessment API (disabled by default)
AEGISAI_AUTH_API_ENABLED=false
AEGISAI_AUTH_API_KEY=
